# Copy to config/.env and fill in values.
# config/.env is gitignored — NEVER commit this file.

# --- Local SQLite (FHIR cache + Apple Health tables) ---
OPENCLAW_HEALTH_DB_PATH="~/.openclaw-health-assistant/openclaw_health.db"

# --- Remote FHIR MCP (https://github.com/maheshbalan/fhir-mcp-server) ---
FHIR_MCP_BASE_URL=https://mcp-fhir-server.com
FHIR_MCP_API_KEY=

FHIR_PATIENT_FIRST_NAME=
FHIR_PATIENT_LAST_NAME=
FHIR_PATIENT_DOB=1990-01-15

# --- Apple Health: QR pairing + local API on your Mac (see Setup Wizard) ---
APPLE_HEALTH_API_BASE_URL=
APPLE_HEALTH_DEVICE_TOKEN=

# --- Ollama / OpenClaw ---
OLLAMA_API_KEY=ollama-local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MEDGEMMA_MODEL=medgemma:4b
OLLAMA_TOOLS_MODEL=qwen3:8b
