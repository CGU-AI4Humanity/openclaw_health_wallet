# Copy to config/.env and fill in values.
# config/.env is gitignored — never commit this file.

# --- Local SQLite (MyWellWallet-compatible) ---
MYWELLWALLET_DB_PATH="${HOME}/.openclaw-health-assistant/mywellwallet.db"

# --- Remote FHIR MCP (https://mcp-fhir-server.com) ---
FHIR_MCP_BASE_URL=https://mcp-fhir-server.com
FHIR_MCP_API_KEY=

# Patient identity for FHIR MCP lookups (set once; agent uses this instead of re-asking)
FHIR_PATIENT_FIRST_NAME=
FHIR_PATIENT_LAST_NAME=
FHIR_PATIENT_DOB=1990-01-15

# --- Ollama / OpenClaw ---
OLLAMA_API_KEY=ollama-local
OLLAMA_HOST=http://127.0.0.1:11434
# Default: medgemma:4b. On 64GB+ RAM try medgemma:27b or a Qwen 4B variant.
OLLAMA_MEDGEMMA_MODEL=medgemma:4b

# Optional: path to MyWellWallet iPhone SQLite export for Apple Health sync
APPLE_HEALTH_PHONE_DB_PATH="${HOME}/myWellWallet/fixtures/test_database_export/mywellwallet_phone.sqlite3"
