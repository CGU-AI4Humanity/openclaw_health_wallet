# Copy to config/.env and fill in values.
# config/.env is gitignored — NEVER commit this file or paste keys into the Git repo.
# Admins issue FHIR MCP keys privately; you store them only here on your Mac.

# --- Local SQLite (MyWellWallet-compatible) ---
MYWELLWALLET_DB_PATH="${HOME}/.openclaw-health-assistant/mywellwallet.db"

# --- Remote FHIR MCP (https://github.com/maheshbalan/fhir-mcp-server) ---
# Hosted API: https://mcp-fhir-server.com — request X-API-Key from administrator
FHIR_MCP_BASE_URL=https://mcp-fhir-server.com
FHIR_MCP_API_KEY=

# Patient identity for FHIR lookups (set once; OpenClaw uses these instead of re-asking)
FHIR_PATIENT_FIRST_NAME=
FHIR_PATIENT_LAST_NAME=
FHIR_PATIENT_DOB=1990-01-15

# --- Apple Health (QR pairing + API — see README Step 5) ---
# After scanning QR on iPhone, paste token from MyWellWallet
APPLE_HEALTH_API_BASE_URL=
APPLE_HEALTH_DEVICE_TOKEN=

# Interim testing only: path to iPhone MyWellWallet SQLite export
APPLE_HEALTH_PHONE_DB_PATH="${HOME}/myWellWallet/fixtures/test_database_export/mywellwallet_phone.sqlite3"

# --- Ollama / OpenClaw ---
OLLAMA_API_KEY=ollama-local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MEDGEMMA_MODEL=medgemma:4b
