// Use when MedGemma rejects MCP tool payloads (no Ollama "tools" capability).
// After: ollama pull qwen3:8b
{
  agents: {
    defaults: {
      model: "ollama/qwen3:8b",
    },
  },
  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        timeoutSeconds: 900,
        models: [
          {
            id: "qwen3:8b",
            name: "Qwen3 8B (tool calling)",
            contextWindow: 32768,
            maxTokens: 8192,
            params: { keep_alive: "15m", num_ctx: 16384 },
          },
          {
            id: "qwen3:4b",
            name: "Qwen3 4B (tool calling)",
            contextWindow: 32768,
            maxTokens: 8192,
            params: { keep_alive: "15m", num_ctx: 16384 },
          },
          {
            id: "medgemma:4b",
            name: "MedGemma 4B",
            contextWindow: 32768,
            maxTokens: 8192,
            params: { keep_alive: "15m", num_ctx: 8192 },
          },
        ],
      },
    },
  },
}
